# syntax=docker/dockerfile:1
#
# Dockerfile.frontend -- the NEXUS web application (docs/SPEC.md sections 8 and 10).
#
# The React/Vite application is built in a Node stage and served by nginx.
# nginx also proxies /api and /ws to the backend service, so the browser only
# ever talks to one origin and the frontend code can use relative URLs
# (AGENTS.md: never point browser code at localhost).
#
# The application directory is resolved at build time (see resolve_source.py)
# so the image works with `apps/web/` and with any other directory that ships
# a package.json with a "build" script.

# The resolver is plain Python, so it runs in a tiny stage of its own and
# hands the resolved facts to the Node stage.
FROM python:3.12-alpine AS resolve

WORKDIR /src
COPY . /src
RUN python /src/infrastructure/docker/resolve_source.py \
        --root /src \
        --env-file /out/nexus-build.env \
        --requirements-file /tmp/nexus-requirements.txt \
        frontend \
    && cat /out/nexus-build.env

FROM node:22-alpine AS build

ENV NPM_CONFIG_AUDIT=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_UPDATE_NOTIFIER=false

WORKDIR /src
COPY --from=resolve /out/nexus-build.env /tmp/nexus-build.env
COPY . /src

# Install exactly the locked dependencies when a lockfile exists, then build
# the static bundle into <app>/dist and copy it to a fixed path so the nginx
# stage does not need to know the application layout.
RUN set -eux; \
    . /tmp/nexus-build.env; \
    cd "${NEXUS_FRONTEND_SRC}"; \
    if [ -f package-lock.json ]; then npm ci --no-audit --no-fund; else npm install --no-audit --no-fund; fi; \
    npm run build; \
    test -d "${NEXUS_FRONTEND_DIST}"; \
    cp -a "${NEXUS_FRONTEND_DIST}" /out

FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime

COPY infrastructure/docker/frontend.nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /out/ /usr/share/nginx/html/

# The unprivileged image already runs as `nginx`; the directive is repeated so
# the runtime user is visible in the image history.
USER nginx

EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=5 \
    CMD wget --quiet --tries=1 --spider http://127.0.0.1:3000/ || exit 1
