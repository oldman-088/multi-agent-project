# NEXUS AGENT OS — Local Browser Bridge image
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    BRIDGE_HOST=0.0.0.0 \
    BRIDGE_PORT=8765

WORKDIR /app

# Install dependencies first so the layer is cached.
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Bridge code.
COPY bridge ./bridge

EXPOSE 8765

# Healthcheck hits the bridge health endpoint from inside the container.
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=5 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8765/health')"

# NOTE: the secure default is BRIDGE_HOST=127.0.0.1 (loopback only). Docker Compose
# overrides this to 0.0.0.0 so the backend can reach the bridge over the internal
# network; the bridge port is NOT published, so it is never exposed to the host.
CMD ["sh", "-c", "uvicorn bridge.main:app --host ${BRIDGE_HOST:-127.0.0.1} --port ${BRIDGE_PORT:-8765}"]
