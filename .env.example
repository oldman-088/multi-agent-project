# ---- NEXUS AGENT OS -- environment template ----
#
#   cp .env.example .env
#
# Fill in the values, then start the stack with `docker compose up --build`.
# Docker Compose reads this file automatically; the backend reads it as well
# when it runs on the host.
#
# NEVER commit a filled-in .env file and never paste a real key in this file.
# Every secret below is empty on purpose: generate the value locally, for
# example with
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ---- Ports published by the compose stack (bound to 127.0.0.1) ----
NEXUS_BACKEND_PORT=8000
NEXUS_FRONTEND_PORT=3000
NEXUS_BRIDGE_PORT=8790

# ---- Application ----
# development | test | production
NEXUS_ENV=development
# DEBUG | INFO | WARNING | ERROR
NEXUS_LOG_LEVEL=INFO
# Echo every SQL statement. Keep it false outside development.
NEXUS_DB_ECHO=false

# ---- Database ----
# Used when the backend runs on the host. The compose stack always uses the
# named volume `backend-data`; NEXUS_COMPOSE_DATABASE_URL overrides the URL
# the containers use (for example to reach an external PostgreSQL).
NEXUS_DATABASE_URL=sqlite+aiosqlite:///./nexus.db
NEXUS_COMPOSE_DATABASE_URL=sqlite+aiosqlite:////data/nexus.db
# Example for PostgreSQL 16 (credentials belong in your secret store, not here):
# NEXUS_COMPOSE_DATABASE_URL=postgresql+asyncpg://nexus:CHANGE_ME@postgres:5432/nexus

# ---- Authentication ----
# Secret used to sign access tokens. Generate a random value.
NEXUS_JWT_SECRET=
# HS256 is the only supported algorithm.
NEXUS_JWT_ALGORITHM=HS256
NEXUS_ACCESS_TOKEN_TTL_SECONDS=3600
NEXUS_REFRESH_TOKEN_TTL_SECONDS=2592000
NEXUS_MAX_FAILED_LOGINS=5
NEXUS_LOCKOUT_SECONDS=300

# ---- Encryption at rest ----
# Fernet key (url-safe base64, 32 bytes) used to encrypt stored credentials.
NEXUS_ENCRYPTION_KEY=

# ---- Local Browser Bridge ----
# The bridge binds the loopback address only. In the compose stack the bridge
# shares the network namespace of the backend service, so the backend always
# reaches it on 127.0.0.1; only change NEXUS_BRIDGE_HOST for host runs.
NEXUS_BRIDGE_HOST=127.0.0.1
# Comma-separated list of browser origins allowed to open a bridge socket.
# Leave empty until a real origin is known, then list them explicitly.
NEXUS_BRIDGE_ALLOWED_ORIGINS=
# Bearer token for the bridge's local HTTP API. At least 32 characters.
# Leave empty to run the bridge without its local API (it then answers 503).
NEXUS_BRIDGE_API_TOKEN=
# Address the bridge binds inside the container namespace. It must be 0.0.0.0
# so the published port works; the published port itself stays on 127.0.0.1.
NEXUS_BRIDGE_BIND_HOST=0.0.0.0

# ---- OpenAI-compatible endpoint (off by default) ----
NEXUS_OPENAI_ENABLED=false
NEXUS_OPENAI_BASE_URL=
# Indirection only: the value of this variable points at the real key, the
# key itself is never stored in this file.
NEXUS_OPENAI_API_KEY_REF=

# ---- Ollama (local model connection) ----
NEXUS_OLLAMA_BASE_URL=http://127.0.0.1:11434
