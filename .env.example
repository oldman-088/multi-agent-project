# ---- NEXUS AGENT OS — environment template ----
# Copy to .env and fill in. NEVER commit a real .env file.
# Secrets must be supplied through environment variables, never in code.

# Application
NEXUS_ENV=development
NEXUS_LOG_LEVEL=INFO

# Database.
# Default is the local-first SQLite (WAL mode) configuration.
# PostgreSQL 16 is a supported alternative behind the same repository layer.
NEXUS_DATABASE_URL=sqlite+aiosqlite:///./nexus.db
# NEXUS_DATABASE_URL=postgresql+asyncpg://nexus:CHANGE_ME@127.0.0.1:5432/nexus

# Authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
NEXUS_JWT_SECRET=
NEXUS_ACCESS_TOKEN_TTL_SECONDS=3600
NEXUS_REFRESH_TOKEN_TTL_SECONDS=2592000

# Secret encryption key (Fernet, url-safe base64).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NEXUS_ENCRYPTION_KEY=

# Local Browser Bridge (always binds loopback)
NEXUS_BRIDGE_HOST=127.0.0.1
NEXUS_BRIDGE_PORT=8790
# Comma-separated allow-list of browser origins permitted to open a bridge socket.
NEXUS_BRIDGE_ALLOWED_ORIGINS=

# OpenAI-compatible endpoint (off by default; keys are encrypted at rest)
NEXUS_OPENAI_ENABLED=false
NEXUS_OPENAI_BASE_URL=
NEXUS_OPENAI_API_KEY_REF=

# Ollama (local model connection)
NEXUS_OLLAMA_BASE_URL=http://127.0.0.1:11434
