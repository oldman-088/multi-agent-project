# NEXUS AGENT OS — environment template.
#
# Copy to `.env` and fill in locally. This file holds PLACEHOLDER values only;
# never commit real secrets, API keys, tokens or passwords.

# --- Application -----------------------------------------------------------
APP_VERSION=0.1.0

# --- Backend --------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Local Browser Bridge -------------------------------------------------
# SECURE DEFAULT: bind to the loopback interface only. Docker Compose overrides
# this to 0.0.0.0 so the backend can reach the bridge over the internal network;
# the bridge port is not published to the host in the compose stack.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765
# Comma-separated list of browser origins allowed to open the WebSocket.
BRIDGE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
# Paired credential shared with the userscript. CHANGE THIS.
BRIDGE_PAIR_TOKEN=change-me

# --- Frontend / nginx -----------------------------------------------------
FRONTEND_PORT=8080

# --- Storage --------------------------------------------------------------
# SQLite (WAL mode) by default for the local single-owner setup.
DATABASE_URL=sqlite+aiosqlite:///./data/nexus.db
